# ==============================================================================
# Environment Configuration Template (.env.local.example)
# Automotive Skills Assessment & Candidate Readiness Platform
# ==============================================================================

# Supabase Public Client Credentials (Protected by Postgres Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Admin / Service Role Credentials (SERVER-ONLY — Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_URL=https://your-project-ref.supabase.co

# Google Gemini API Key (SERVER-ONLY — Document OCR & Audio Assessment Analysis)
GEMINI_API_KEY=your-google-gemini-api-key

# Brevo Transactional Email Service (SERVER-ONLY — Examiner Onboarding & Alerts)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com.au
BREVO_SENDER_NAME="AutoSkills Platform"

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
