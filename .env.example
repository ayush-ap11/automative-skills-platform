# ==============================================================================
# Environment Configuration Template
# Automotive Skills Assessment & Candidate Readiness Platform
# ==============================================================================
# Security Policy:
# - NEVER commit real credentials, production keys, or secret tokens.
# - Keep .env, .env.local, and .env.production ignored in git.
# - Rotate any credential that has ever been exposed or committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Client Credentials (Public-Safe via Row Level Security)
# ------------------------------------------------------------------------------
# The Supabase URL for your project instance.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The Supabase Anon/Publishable API Key. Safe for browser usage because all
# PostgreSQL tables and storage buckets strictly enforce Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Supabase Elevated Admin Credentials (STRICTLY SERVER-ONLY - NEVER EXPOSE)
# ------------------------------------------------------------------------------
# Elevated service-role key for administrative tasks and server actions.
# Bypasses Postgres Row Level Security (RLS). Must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Optional fallback used by server admin client if NEXT_PUBLIC_SUPABASE_URL is omitted.
SUPABASE_URL=https://your-project-ref.supabase.co

# ------------------------------------------------------------------------------
# 3. AI / LLM Configuration (Google Gemini) - SERVER-ONLY
# ------------------------------------------------------------------------------
# API Key for Google Generative AI (gemini-3.5-flash-lite) used for automated
# qualification document OCR extraction, verbal transcript safety analysis, and EV readiness scoring.
GEMINI_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# 4. Email Service (Brevo Transactional Email) - SERVER-ONLY
# ------------------------------------------------------------------------------
# Brevo API key used to send examiner invitation emails with one-time credentials.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com.au
BREVO_SENDER_NAME="AutoSkills Platform"

# ------------------------------------------------------------------------------
# 5. Application URL
# ------------------------------------------------------------------------------
# Public base URL of the web application for email links and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
